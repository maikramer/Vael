<?xml version="1.0" encoding="UTF-8"?>
<!-- Barra de fala do NLU/d1. O HUD visual passou para `ui/hud.xaml` (bevy_pf);
     este root fica só com o `<UiInput>` que o `scripts/ui/say.lua` foca. O id
     continua `hud` para o `viber.ui.set_visible("hud", …)` de título/morte e
     para as folhas de estilo existentes. -->
<world static="true">
  <UiStyle src="ui/theme.css" />
  <UiStyle src="ui/hud.css" />
  <UiRoot id="hud" script="ui/hud.lua">
    <UiRow id="say" class="anchor-say" bind="say.active" fade="0.1 0.15">
      <UiPanel class="hud-card say-card">
        <UiText id="say-prompt" class="say-prompt" bind="say.prompt" />
        <UiInput id="say-input" class="say-input" placeholder="uma palavra" max-length="48" />
      </UiPanel>
    </UiRow>
  </UiRoot>
</world>
