<?xml version="1.0" encoding="UTF-8"?>
<world static="true">
  <!-- Cada UiRoot só vê as folhas que carrega (shadow-DOM-lite): sem o
       theme aqui, os `.keycap` dos Controlos ficavam sem a base. -->
  <UiStyle src="ui/theme.css" />
  <UiStyle src="ui/menu.css" />
  <UiRoot id="menu-layer" script="ui/menu.lua" class="menu-layer">
    <UiModal id="menu" key="q" class="overlay">
      <UiColumn class="frame">
        <UiRow class="frame-head">
          <UiColumn class="title-block">
            <UiText class="frame-title">@menu.title</UiText>
            <UiText class="frame-sub" bind="clock">06:00</UiText>
          </UiColumn>
          <UiSpacer />
          <!-- As três fichas de estado são bindings do JOGO (`lib/rules.lua`).
               Na cena de menu as regras não correm: os binds ficavam com os
               valores autorais (Nível 1, 100/100, 0 de ouro) e mentiam sobre
               o save. `menu.lua` esconde a linha inteira onde não há jogo. -->
          <UiRow id="head-stats" class="head-stats">
            <UiPanel class="head-stat">
              <UiText class="head-stat-key">@menu.health</UiText>
              <UiText class="head-stat-value" bind="health.text">100/100</UiText>
            </UiPanel>
            <UiPanel class="head-stat">
              <UiText class="head-stat-key">@menu.level</UiText>
              <UiText class="head-stat-value" bind="level.text">1</UiText>
            </UiPanel>
            <UiPanel class="head-stat">
              <UiText class="head-stat-key">@menu.gold</UiText>
              <UiText class="head-stat-value" bind="gold">0</UiText>
            </UiPanel>
          </UiRow>
          <UiButton id="menu-close" class="close">
            <UiText>×</UiText>
          </UiButton>
        </UiRow>
        <UiRow class="tabbar">
          <UiButton class="tab" tab-group="menu" tab="quests">
            <UiText>@menu.tab.quests</UiText>
          </UiButton>
          <UiButton class="tab" tab-group="menu" tab="bag">
            <UiText>@menu.tab.bag</UiText>
          </UiButton>
          <UiButton class="tab" tab-group="menu" tab="skills">
            <UiText>@menu.tab.skills</UiText>
          </UiButton>
          <UiButton class="tab" tab-group="menu" tab="shop">
            <UiText>@menu.tab.shop</UiText>
          </UiButton>
          <UiButton class="tab" tab-group="menu" tab="forge">
            <UiText>@menu.tab.forge</UiText>
          </UiButton>
          <UiButton class="tab" tab-group="menu" tab="controls">
            <UiText>@menu.tab.controls</UiText>
          </UiButton>
          <UiButton class="tab" tab-group="menu" tab="a11y">
            <UiText>@menu.tab.a11y</UiText>
          </UiButton>
          <UiButton class="tab" tab-group="menu" tab="system">
            <UiText>@menu.tab.system</UiText>
          </UiButton>
        </UiRow>
        <UiColumn class="page" tab-group="menu" tab="quests">
          <UiList class="rows" bind="quests" scroll="y">
            <UiTemplate>
              <UiButton id="track-{id}" class="row quest {status} {tracked}" tooltip="Seguir ou parar de seguir esta missão na bússola e no cartão do HUD">
                <UiPanel class="row-flag" />
                <UiColumn class="row-body">
                  <UiRow class="row-line">
                    <UiText class="row-title">{title}</UiText>
                    <UiSpacer />
                    <UiText class="row-tag">{status_text}</UiText>
                  </UiRow>
                  <UiText class="row-note">{objective} · {biome_name}</UiText>
                  <UiRow class="row-line">
                    <UiBar class="row-bar" value="{progress}" />
                    <UiText class="row-count">{progress_text}</UiText>
                  </UiRow>
                </UiColumn>
              </UiButton>
            </UiTemplate>
            <UiEmpty>
              <UiText class="empty">@menu.quests.empty</UiText>
            </UiEmpty>
          </UiList>
        </UiColumn>
        <UiColumn class="page" tab-group="menu" tab="bag">
          <UiList class="grid" bind="bag" scroll="y">
            <UiTemplate>
              <UiButton id="bag-{id}" class="cell {kind} {status} {equip}" tooltip="{tip}">
                <UiPanel class="cell-icon {id}" />
                <UiText class="cell-label">{label}</UiText>
                <UiText class="cell-count">{count}</UiText>
                <UiText class="cell-tag">{tag}</UiText>
              </UiButton>
            </UiTemplate>
            <UiEmpty>
              <UiText class="empty">@menu.bag.empty</UiText>
            </UiEmpty>
          </UiList>
        </UiColumn>
        <UiColumn class="page" tab-group="menu" tab="skills">
          <!-- O custo é 1 ponto por talento; sem esta linha o jogador tinha de
               adivinhar se ainda tinha pontos (o + do HUD só diz que há). -->
          <UiRow class="row keyline skills-points">
            <UiText class="row-note">@menu.skills.points</UiText>
            <UiSpacer />
            <UiText class="row-title" bind="talent.points">0</UiText>
          </UiRow>
          <UiList class="rows" bind="skills" scroll="y">
            <UiTemplate>
              <UiButton id="skill-{id}" class="row skill {status}">
                <UiPanel class="row-flag" />
                <UiColumn class="row-body">
                  <UiRow class="row-line">
                    <UiText class="row-title">{label}</UiText>
                    <UiSpacer />
                    <UiText class="row-tag">{status_text}</UiText>
                  </UiRow>
                  <UiText class="row-note">{requires}</UiText>
                </UiColumn>
              </UiButton>
            </UiTemplate>
          </UiList>
        </UiColumn>
        <UiColumn class="page" tab-group="menu" tab="shop">
          <UiList class="rows" bind="shop" scroll="y">
            <UiTemplate>
              <UiButton id="shop-{id}" class="row trade {status}">
                <UiPanel class="row-flag" />
                <UiColumn class="row-body">
                  <UiRow class="row-line">
                    <UiText class="row-title">{label}</UiText>
                    <UiSpacer />
                    <UiText class="row-price">{price}</UiText>
                  </UiRow>
                </UiColumn>
              </UiButton>
            </UiTemplate>
          </UiList>
        </UiColumn>
        <UiColumn class="page" tab-group="menu" tab="forge">
          <UiRow class="row keyline skills-points">
            <UiText class="row-note">@menu.forge.hint</UiText>
          </UiRow>
          <UiList class="rows" bind="forge" scroll="y">
            <UiTemplate>
              <UiButton id="forge-{id}" class="row craft {status}">
                <UiPanel class="row-flag" />
                <UiColumn class="row-body">
                  <UiRow class="row-line">
                    <UiText class="row-title">{label}</UiText>
                    <UiSpacer />
                    <UiText class="row-tag">{status_text}</UiText>
                  </UiRow>
                  <UiText class="row-note">{cost}</UiText>
                  <UiText class="row-note">{note}</UiText>
                </UiColumn>
              </UiButton>
            </UiTemplate>
          </UiList>
        </UiColumn>
        <UiColumn class="page" tab-group="menu" tab="controls">
          <UiList class="rows tight" bind="controls" scroll="y">
            <UiTemplate>
              <UiRow class="row keyline">
                <UiPanel class="keycap wide">
                  <UiText>{key}</UiText>
                </UiPanel>
                <UiText class="row-note">{action}</UiText>
              </UiRow>
            </UiTemplate>
          </UiList>
        </UiColumn>
        <UiColumn class="page" tab-group="menu" tab="a11y">
          <UiList class="rows tight" bind="a11y" scroll="y">
            <UiTemplate>
              <UiButton id="a11y-{id}" class="row keyline">
                <UiText class="row-note">{label}</UiText>
                <UiSpacer />
                <UiText class="row-title">{value}</UiText>
              </UiButton>
            </UiTemplate>
          </UiList>
        </UiColumn>
        <UiColumn class="page" tab-group="menu" tab="system">
          <UiList class="rows tight" bind="system" scroll="y">
            <UiTemplate>
              <UiRow class="row keyline">
                <UiText class="row-note">{key}</UiText>
                <UiSpacer />
                <UiText class="row-title">{value}</UiText>
              </UiRow>
            </UiTemplate>
          </UiList>
          <UiRow class="actions">
            <UiButton id="act-save-1" class="action">
              <UiText id="act-save-1-label">@menu.save1</UiText>
            </UiButton>
            <UiButton id="act-save-2" class="action">
              <UiText id="act-save-2-label">@menu.save2</UiText>
            </UiButton>
            <UiButton id="act-save-3" class="action">
              <UiText id="act-save-3-label">@menu.save3</UiText>
            </UiButton>
            <!-- Os rótulos têm id próprio: `viber.ui.set_text` só escreve num
                 UiText (um UiButton não tem componente de texto). O menu
                 passa a dizer o nível/tempo de jogo de cada slot em vez de um
                 "Carregar N" mudo. -->
            <UiButton id="act-load-1" class="action ghost">
              <UiText id="act-load-1-label">Carregar 1</UiText>
            </UiButton>
            <UiButton id="act-load-2" class="action ghost">
              <UiText id="act-load-2-label">Carregar 2</UiText>
            </UiButton>
            <UiButton id="act-load-3" class="action ghost">
              <UiText id="act-load-3-label">Carregar 3</UiText>
            </UiButton>
            <UiButton id="act-title" class="action ghost">
              <UiText>@menu.to_title</UiText>
            </UiButton>
            <UiButton id="act-profiler" class="action ghost">
              <UiText>@menu.profiler</UiText>
            </UiButton>
          </UiRow>
        </UiColumn>
        <UiRow class="frame-foot">
          <UiText class="foot-note">@menu.foot</UiText>
        </UiRow>
      </UiColumn>
    </UiModal>
  </UiRoot>
</world>
