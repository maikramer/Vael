<?xml version="1.0" encoding="UTF-8"?>
<world static="true">
  <Group name="environment" translation="0 38.7304 0">
    <!-- Céu, sol/lua/estrelas, clima, nuvens, chuva/neve e relâmpagos são do
         `bevy_elements` (`src/environment.rs`): relógio astronómico a 50° de
         latitude, dia de ~20 min reais, numa câmara `ElementsCamera`. O
         `<DayCycle>`, o `<Sky>`, o `<Weather>` e a luz direcional/ambiente
         autorais SAÍRAM: com eles a engine conduzia um segundo céu por cima
         do crate. `VAEL_ELEMENTS=0` desliga o crate — para voltar ao céu
         antigo é preciso repor esses elementos aqui. -->
    <AdaptiveQuality target-fps="60" min-pixel-ratio="0.55" max-pixel-ratio="1.5" />
    <WorldBorder radius="1800" warn-seconds="5" margin="80" />
    <AudioMixer master="1" music="0.7" sfx="0.8" voice="0.9" ambience="0.7" />
    <MusicLayer layer="explore" sound="bgm-explore" base-volume="0.18" />
    <MusicLayer layer="battle" sound="bgm-battle" base-volume="0.22" />
    <MusicLayer layer="boss" sound="bgm-boss" base-volume="0.24" />
    <MusicLayer layer="dungeon" sound="bgm-dungeon" base-volume="0.2" />
    <MusicLayer layer="village" sound="bgm-village" base-volume="0.18" />
    <!-- Biomas: a layer homónima do BiomeRegion.id acende por posição
         (`music::auto_zone`), sem o script forçar a layer — forçar ganharia
         ao combate. -->
    <MusicLayer layer="dark-forest" sound="bgm-dark-forest" base-volume="0.18" />
    <MusicLayer layer="desert" sound="bgm-desert" base-volume="0.18" />
    <MusicLayer layer="swamp" sound="bgm-swamp" base-volume="0.17" />
    <MusicLayer layer="frozen-peaks" sound="bgm-frozen-peaks" base-volume="0.2" />
    <BiomeRegion id="dark-forest" display-name="Floresta Sombria" polygon="[-56,56;56,56;4040,4040;-4040,4040]" tint="#1a3320" fog-density="0.0008" pp-exposure="0.78" />
    <BiomeRegion id="desert" display-name="Ermo Rubro" polygon="[56,-56;56,56;4040,4040;4040,-4040]" tint="#c2a878" fog-density="0.0006" pp-exposure="0.74" pp-bloom-strength="0.18" rain-scale="0.1" />
    <BiomeRegion id="swamp" display-name="Pântano da Bruma" polygon="[-56,-56;-56,56;-4040,4040;-4040,-4040]" tint="#3a4a30" fog-density="0.0030" pp-exposure="0.70" />
    <BiomeRegion id="frozen-peaks" display-name="Picos Gelados" polygon="[-240,-240;240,-240;4040,-4040;-4040,-4040]" tint="#cdd9e6" fog-density="0.0006" pp-exposure="0.78" />
