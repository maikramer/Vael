<?xml version="1.0" encoding="UTF-8"?>
<world static="true">
  <UiStyle src="ui/profiler.css" />
  <UiRoot id="profiler" script="ui/profiler.lua">
    <UiModal id="profiler-win" key="p" escape-closes="true" class="prof-overlay">
      <UiRow class="head">
        <UiColumn class="titles">
          <UiText class="title">PROFILER</UiText>
          <UiText class="sub">P alterna · [ ] 1-6 abas · F12 congela · ` exporta · Pg± raio</UiText>
        </UiColumn>
        <UiSpacer />
        <UiColumn class="head-stat">
          <UiText id="prof-fps" class="fps">—</UiText>
          <UiText class="fps-key">FPS</UiText>
        </UiColumn>
      </UiRow>
      <UiRow class="tabbar">
        <UiButton id="prof-tab-systems" class="tab" tab-group="prof" tab="systems">
          <UiText>SISTEMAS</UiText>
        </UiButton>
        <UiButton id="prof-tab-world" class="tab" tab-group="prof" tab="world">
          <UiText>MUNDO</UiText>
        </UiButton>
        <UiButton id="prof-tab-physics" class="tab" tab-group="prof" tab="physics">
          <UiText>FÍSICA</UiText>
        </UiButton>
        <UiButton id="prof-tab-audio" class="tab" tab-group="prof" tab="audio">
          <UiText>ÁUDIO</UiText>
        </UiButton>
        <UiButton id="prof-tab-extras" class="tab" tab-group="prof" tab="extras">
          <UiText>EXTRAS</UiText>
        </UiButton>
        <UiButton id="prof-tab-frames" class="tab" tab-group="prof" tab="frames">
          <UiText>FRAMES</UiText>
        </UiButton>
      </UiRow>
      <UiColumn class="pane" tab-group="prof" tab="systems">
        <UiRow class="statgrid">
          <UiColumn class="stat">
            <UiText class="k">FRAME</UiText>
            <UiText id="prof-frame" class="v">—</UiText>
          </UiColumn>
          <UiColumn class="stat">
            <UiText class="k">P95</UiText>
            <UiText id="prof-p95" class="v">—</UiText>
          </UiColumn>
          <UiColumn class="stat">
            <UiText class="k">PIOR FPS</UiText>
            <UiText id="prof-worst" class="v">—</UiText>
          </UiColumn>
          <UiColumn class="stat">
            <UiText class="k">MARGEM 60</UiText>
            <UiText id="prof-head" class="v">—</UiText>
          </UiColumn>
        </UiRow>
        <UiRow class="actions">
          <UiButton id="prof-freeze" class="btn">
            <UiText id="prof-freeze-label">CONGELAR</UiText>
          </UiButton>
          <UiButton id="prof-reset" class="btn">
            <UiText>RESET</UiText>
          </UiButton>
          <UiButton id="prof-copy-systems" class="btn">
            <UiText>COPIAR</UiText>
          </UiButton>
          <UiButton id="prof-export-systems" class="btn">
            <UiText>EXPORTAR</UiText>
          </UiButton>
        </UiRow>
        <UiText class="sect">GRUPOS (ms · % do frame)</UiText>
        <UiList class="rows" bind="prof-groups" scroll="y">
          <UiTemplate>
            <UiRow class="lrow">
              <UiText class="l-name">{name}</UiText>
              <UiSpacer />
              <UiText class="l-val">{val}</UiText>
            </UiRow>
          </UiTemplate>
          <UiEmpty>
            <UiText class="empty">sem amostras</UiText>
          </UiEmpty>
        </UiList>
        <UiText class="sect">SISTEMAS (média · p95)</UiText>
        <UiList class="rows tall" bind="prof-systems" scroll="y">
          <UiTemplate>
            <UiRow class="lrow">
              <UiText class="l-name">{name}</UiText>
              <UiSpacer />
              <UiText class="l-val">{val}</UiText>
            </UiRow>
          </UiTemplate>
          <UiEmpty>
            <UiText class="empty">sem amostras</UiText>
          </UiEmpty>
        </UiList>
        <UiText class="sect">SCRIPTS LUAU (média por ficheiro)</UiText>
        <UiList class="rows" bind="prof-scripts" scroll="y">
          <UiTemplate>
            <UiRow class="lrow">
              <UiText class="l-name">{name}</UiText>
              <UiSpacer />
              <UiText class="l-val">{val}</UiText>
            </UiRow>
          </UiTemplate>
          <UiEmpty>
            <UiText class="empty">nenhum script activo</UiText>
          </UiEmpty>
        </UiList>
      </UiColumn>
      <UiColumn class="pane" tab-group="prof" tab="world">
        <UiRow class="actions">
          <UiButton id="prof-radius-down" class="btn">
            <UiText>RAIO −</UiText>
          </UiButton>
          <UiButton id="prof-radius-up" class="btn">
            <UiText>RAIO +</UiText>
          </UiButton>
          <UiButton id="prof-copy-world" class="btn">
            <UiText>COPIAR</UiText>
          </UiButton>
          <UiButton id="prof-export-world" class="btn">
            <UiText>EXPORTAR</UiText>
          </UiButton>
          <UiSpacer />
          <UiText id="prof-nearby" class="chipv">—</UiText>
        </UiRow>
        <UiRow class="statline">
          <UiText class="k">PLAYER</UiText>
          <UiSpacer />
          <UiText id="prof-player" class="v">—</UiText>
        </UiRow>
        <UiRow class="statline">
          <UiText class="k">CÂMERA</UiText>
          <UiSpacer />
          <UiText id="prof-cam" class="v">—</UiText>
        </UiRow>
        <UiRow class="statline">
          <UiText class="k">ENTIDADES</UiText>
          <UiSpacer />
          <UiText id="prof-entities" class="v">—</UiText>
        </UiRow>
        <UiText class="sect">PRÓXIMAS (nome · dist · pos · tags)</UiText>
        <UiList class="rows tall" bind="prof-nearby-rows" scroll="y">
          <UiTemplate>
            <UiRow class="lrow">
              <UiText class="l-name">{name}</UiText>
              <UiSpacer />
              <UiText class="l-val">{val}</UiText>
            </UiRow>
          </UiTemplate>
          <UiEmpty>
            <UiText class="empty">nada no raio</UiText>
          </UiEmpty>
        </UiList>
      </UiColumn>
      <UiColumn class="pane" tab-group="prof" tab="physics">
        <UiRow class="actions">
          <UiButton id="prof-copy-physics" class="btn">
            <UiText>COPIAR</UiText>
          </UiButton>
          <UiButton id="prof-export-physics" class="btn">
            <UiText>EXPORTAR</UiText>
          </UiButton>
        </UiRow>
        <UiRow class="statline">
          <UiText class="k">CORPOS</UiText>
          <UiSpacer />
          <UiText id="prof-bodies" class="v">—</UiText>
        </UiRow>
        <UiRow class="statline">
          <UiText class="k">SONO</UiText>
          <UiSpacer />
          <UiText id="prof-sleep" class="v">—</UiText>
        </UiRow>
        <UiRow class="statline">
          <UiText class="k">COLISORES</UiText>
          <UiSpacer />
          <UiText id="prof-colliders" class="v">—</UiText>
        </UiRow>
        <UiRow class="statline">
          <UiText class="k">STEP</UiText>
          <UiSpacer />
          <UiText id="prof-step" class="v">—</UiText>
        </UiRow>
        <UiRow class="statline">
          <UiText class="k">RAPIER</UiText>
          <UiSpacer />
          <UiText id="prof-rapier" class="v">—</UiText>
        </UiRow>
        <UiText class="sect">FORMAS</UiText>
        <UiList class="rows" bind="prof-shapes" scroll="y">
          <UiTemplate>
            <UiRow class="lrow">
              <UiText class="l-name">{name}</UiText>
              <UiSpacer />
              <UiText class="l-val">{val}</UiText>
            </UiRow>
          </UiTemplate>
          <UiEmpty>
            <UiText class="empty">sem contexto Rapier</UiText>
          </UiEmpty>
        </UiList>
      </UiColumn>
      <UiColumn class="pane" tab-group="prof" tab="audio">
        <UiRow class="actions">
          <UiButton id="prof-copy-audio" class="btn">
            <UiText>COPIAR</UiText>
          </UiButton>
          <UiButton id="prof-export-audio" class="btn">
            <UiText>EXPORTAR</UiText>
          </UiButton>
        </UiRow>
        <UiRow class="statline">
          <UiText class="k">BUSES</UiText>
          <UiSpacer />
          <UiText id="prof-buses" class="v">—</UiText>
        </UiRow>
        <UiRow class="statline">
          <UiText class="k">SINKS</UiText>
          <UiSpacer />
          <UiText id="prof-sinks" class="v">—</UiText>
        </UiRow>
        <UiText class="sect">MÚSICA (layers)</UiText>
        <UiList class="rows" bind="prof-layers" scroll="y">
          <UiTemplate>
            <UiRow class="lrow">
              <UiText class="l-name">{name}</UiText>
              <UiSpacer />
              <UiText class="l-val">{val}</UiText>
            </UiRow>
          </UiTemplate>
          <UiEmpty>
            <UiText class="empty">sem layers activos</UiText>
          </UiEmpty>
        </UiList>
        <UiText class="sect">SINKS (a tocar primeiro)</UiText>
        <UiList class="rows tall" bind="prof-sink-rows" scroll="y">
          <UiTemplate>
            <UiRow class="lrow">
              <UiText class="l-name">{name}</UiText>
              <UiSpacer />
              <UiText class="l-val">{val}</UiText>
            </UiRow>
          </UiTemplate>
          <UiEmpty>
            <UiText class="empty">sem sinks</UiText>
          </UiEmpty>
        </UiList>
      </UiColumn>
      <UiColumn class="pane" tab-group="prof" tab="extras">
        <UiRow class="actions">
          <UiButton id="prof-copy-extras" class="btn">
            <UiText>COPIAR</UiText>
          </UiButton>
          <UiButton id="prof-export-extras" class="btn">
            <UiText>EXPORTAR</UiText>
          </UiButton>
        </UiRow>
        <UiText class="sect">TOGGLES DE DEBUG DA ENGINE</UiText>
        <UiButton id="prof-extra-1" class="extra">
          <UiText id="prof-extra-label-1" class="l-name">—</UiText>
          <UiSpacer />
          <UiText id="prof-extra-state-1" class="state">—</UiText>
        </UiButton>
        <UiButton id="prof-extra-2" class="extra">
          <UiText id="prof-extra-label-2" class="l-name">—</UiText>
          <UiSpacer />
          <UiText id="prof-extra-state-2" class="state">—</UiText>
        </UiButton>
        <UiButton id="prof-extra-3" class="extra">
          <UiText id="prof-extra-label-3" class="l-name">—</UiText>
          <UiSpacer />
          <UiText id="prof-extra-state-3" class="state">—</UiText>
        </UiButton>
        <UiButton id="prof-extra-4" class="extra">
          <UiText id="prof-extra-label-4" class="l-name">—</UiText>
          <UiSpacer />
          <UiText id="prof-extra-state-4" class="state">—</UiText>
        </UiButton>
        <UiButton id="prof-extra-5" class="extra">
          <UiText id="prof-extra-label-5" class="l-name">—</UiText>
          <UiSpacer />
          <UiText id="prof-extra-state-5" class="state">—</UiText>
        </UiButton>
        <UiText id="prof-extra-desc" class="desc" />
      </UiColumn>
      <UiColumn class="pane" tab-group="prof" tab="frames">
        <UiRow class="statgrid">
          <UiColumn class="stat">
            <UiText class="k">FRAME</UiText>
            <UiText id="prof-f-frame" class="v">—</UiText>
          </UiColumn>
          <UiColumn class="stat">
            <UiText class="k">P95</UiText>
            <UiText id="prof-f-p95" class="v">—</UiText>
          </UiColumn>
          <UiColumn class="stat">
            <UiText class="k">PICO</UiText>
            <UiText id="prof-f-max" class="v">—</UiText>
          </UiColumn>
          <UiColumn class="stat">
            <UiText class="k">HITCHES</UiText>
            <UiText id="prof-f-hitches" class="v">—</UiText>
          </UiColumn>
        </UiRow>
        <UiRow class="actions">
          <UiButton id="prof-trace-start" class="btn">
            <UiText>TRAÇAR 10s</UiText>
          </UiButton>
          <UiButton id="prof-trace-stop" class="btn">
            <UiText>PARAR</UiText>
          </UiButton>
          <UiButton id="prof-trace-export" class="btn">
            <UiText>EXPORTAR TRACE</UiText>
          </UiButton>
          <UiButton id="prof-copy-frames" class="btn">
            <UiText>COPIAR</UiText>
          </UiButton>
          <UiButton id="prof-export-frames" class="btn">
            <UiText>EXPORTAR</UiText>
          </UiButton>
        </UiRow>
        <UiText id="prof-f-history" class="hist">—</UiText>
        <UiText class="sect">HITCHES RECENTES (frame · ms · topo)</UiText>
        <UiList class="rows tall" bind="prof-f-hitch-rows" scroll="y">
          <UiTemplate>
            <UiRow class="lrow">
              <UiText class="l-name">{name}</UiText>
              <UiSpacer />
              <UiText class="l-val">{val}</UiText>
            </UiRow>
          </UiTemplate>
          <UiEmpty>
            <UiText class="empty">sem hitches</UiText>
          </UiEmpty>
        </UiList>
        <UiText class="sect">SISTEMAS MAIS CAROS (média · p95)</UiText>
        <UiList class="rows" bind="prof-f-top-rows" scroll="y">
          <UiTemplate>
            <UiRow class="lrow">
              <UiText class="l-name">{name}</UiText>
              <UiSpacer />
              <UiText class="l-val">{val}</UiText>
            </UiRow>
          </UiTemplate>
          <UiEmpty>
            <UiText class="empty">sem amostras</UiText>
          </UiEmpty>
        </UiList>
        <UiText class="sect">MEMÓRIA / TRACE</UiText>
        <UiText id="prof-f-mem" class="v">—</UiText>
        <UiText id="prof-f-trace" class="v">—</UiText>
      </UiColumn>
      <UiText id="prof-status" class="status">—</UiText>
    </UiModal>
  </UiRoot>
</world>
