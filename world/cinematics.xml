<world static="true">
  <Cinematic id="prologo" skippable="true" letterbox="true">
    <Fade at="0" duration="2.2" from="1" to="0" />
    <Sound at="0.4" clip="notification" />
    <Shot duration="8" from="112 70 146" to="84 66 112" look="0 44 -4" look-to="8 46 6" fov="46" ease="in-out" />
    <Title at="1.8" duration="5" sub="Capítulo I · A Nota">O Silêncio de Vael</Title>
    <Line at="7.6" duration="3.0" speaker="Ancião Edmar">Há trinta invernos que o Coro de Vael não canta.</Line>
    <Shot duration="3.6" from="940 205 836" to="926 205 824" look="880 204 780" look-to="880 204 780" fov="44" ease="out" />
    <Shot duration="3.4" from="920 205 820" to="912 208 816" look="880 204 780" look-to="879 205 780" fov="42" ease="in-out" />
    <Line at="10.8" duration="4.2" speaker="Ancião Edmar">Lá em cima, no Alto, os cristais cantavam — e enquanto cantavam, a bruma ficava no pântano e os bichos nos covis.</Line>
    <Shot duration="3.3" from="-738 204 -270" to="-765 201 -285" look="-880 193 -305" look-to="-880 193 -305" fov="50" ease="out" />
    <Shot duration="3.2" from="-783 197 -295" to="-795 195 -299" look="-880 193 -300" look-to="-880 193 -300" fov="44" ease="in-out" />
    <Line at="15.4" duration="4.6" speaker="Ancião Edmar">Até a Cidadela cair numa só noite. O canto partiu-se em quatro Notas, e quatro criaturas engoliram-nas.</Line>
    <Shot duration="7.5" anchor="player" from="4.8 1.7 6.4" to="2.2 1.55 3.4" look="0 1.25 0" look-to="0 1.5 0" fov="40" ease="out" />
    <Line at="21.8" duration="4.2" speaker="Ancião Edmar">Tu vieste medir a terra, cartógrafo. Mede-a bem — e encontra-as.</Line>
    <Line at="26.1" duration="2.9" speaker="Ancião Edmar">Procura-me junto ao salão comunal.</Line>
  </Cinematic>
  <Cinematic id="guardiao-bruxa" skippable="true">
    <Sound at="0.2" clip="boss_roar" />
    <Shot duration="3" anchor="self" from="7 2.2 7" to="4.5 3.2 4.5" look="0 1.8 0" look-to="0 2.0 0" ease="out" />
    <Shot duration="3.6" anchor="self" from="-2.5 1.0 5.5" to="-3.5 1.3 4.6" look="0 2.3 0" ease="in-out" />
    <Title at="0.6" duration="3.2" sub="Guardiã da Nota do Bosque">A Bruxa do Bosque</Title>
    <Line at="3.2" duration="3.4" speaker="Irmã Vessa">Quando ela apontar o chão onde pisas, sai. A maldição cai no mesmo sítio.</Line>
  </Cinematic>
