<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid.Resources>
    <SolidColorBrush x:Key="Gold" Color="#FFE7C987"/>
    <SolidColorBrush x:Key="GoldDeep" Color="#FFA8854C"/>
    <SolidColorBrush x:Key="Muted" Color="#FFB7A98F"/>
    <SolidColorBrush x:Key="Ink" Color="#FFF2E8D5"/>

    <Style x:Key="RowButton" TargetType="Button">
      <Setter Property="Background" Value="#99171D20"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="BorderBrush" Value="#44B7A477"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="Margin" Value="0,2"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>

    <DataTemplate x:Key="MapRowTemplate">
      <Button Style="{StaticResource RowButton}"
              Command="{Binding DataContext.map_command, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
              CommandParameter="{Binding action}">
        <Grid ColumnDefinitions="*,Auto" Width="620">
          <StackPanel>
            <TextBlock Text="{Binding title}" FontSize="14" Foreground="{StaticResource Ink}"/>
            <TextBlock Text="{Binding subtitle}" FontSize="11" Foreground="{StaticResource Muted}"/>
          </StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding tag}" FontSize="12"
                     Foreground="{StaticResource Gold}" Margin="10,0,0,0"
                     VerticalAlignment="Center"/>
        </Grid>
      </Button>
    </DataTemplate>
  </Grid.Resources>

  <!-- ── mapa regional ─────────────────────────────────────────────────── -->
  <Grid Visibility="{Binding map_open}" Background="#C80C0A09">
    <Border Width="720" Height="700" HorizontalAlignment="Center" VerticalAlignment="Center"
            Background="#FF0D1210" BorderBrush="#70A8854C" BorderThickness="1"
            CornerRadius="12" Padding="22,16">
      <Grid RowDefinitions="Auto,*,Auto,Auto">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Grid Width="24" Height="24" VerticalAlignment="Center">
                <Path Width="24" Height="24" Stretch="None" Fill="#00000000"
                      Stroke="{StaticResource Gold}" StrokeThickness="1.3"
                      Data="M12 0.8 L21.8 4.1 V11.2 C21.8 17.2 17.2 21.4 12 23.2 C6.8 21.4 2.2 17.2 2.2 11.2 V4.1 Z"/>
                <Path Width="24" Height="24" Stretch="None" Fill="#00000000"
                      Stroke="{StaticResource Gold}" StrokeThickness="1.3"
                      Data="M7.5 7.1 L12 16.5 L16.5 7.1"/>
              </Grid>
              <TextBlock Text="{Binding map_title}" FontSize="26" FontWeight="Bold"
                         FontFamily="Noto Serif Display, serif"
                         Foreground="{StaticResource Gold}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="{Binding map_sub}" FontSize="13" Foreground="{StaticResource Muted}"/>
          </StackPanel>
          <Button Grid.Column="1" Content="×" Command="{Binding map_command}"
                  CommandParameter="map-close" Width="34" Height="34" FontSize="18"
                  Padding="0" Background="#66171D20" Foreground="#FFE6D5AD"
                  BorderBrush="#55B7A477" BorderThickness="1"/>
        </Grid>

        <Border Grid.Row="1" Width="460" Height="460" Margin="0,10"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#FF0C0A09">
          <Grid Width="460" Height="460">
            <Image Source="ui/vael_map.png" Width="460" Height="460" Stretch="Fill"/>
            <Grid x:Name="map-player" HorizontalAlignment="Left" VerticalAlignment="Top"
                  Margin="{Binding player_margin}" Width="20" Height="20"
                  Visibility="{Binding player_visible}">
              <Border Width="20" Height="20" CornerRadius="10" Background="#66E6C888"/>
              <Border Width="12" Height="12" CornerRadius="6" Background="#FFE6C888"
                      BorderBrush="#FF0C0A09" BorderThickness="2"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <Grid x:Name="map-waypoint" HorizontalAlignment="Left" VerticalAlignment="Top"
                  Margin="{Binding waypoint_margin}" Width="20" Height="20"
                  Visibility="{Binding waypoint_visible}">
              <Border Width="20" Height="20" CornerRadius="10" Background="#668FD4FF"/>
              <Border Width="12" Height="12" CornerRadius="6" Background="#FF8FD4FF"
                      BorderBrush="#FF0C0A09" BorderThickness="2"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
          </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="0,6">
          <Border Width="10" Height="10" CornerRadius="5" Background="#FFE6C888"
                  VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="tu" FontSize="11" Foreground="{StaticResource Muted}"
                     Margin="6,0,14,0"/>
          <Border Grid.Column="2" Width="10" Height="10" CornerRadius="5" Background="#FF8FD4FF"
                  VerticalAlignment="Center"/>
          <TextBlock Grid.Column="3" Text="destino" FontSize="11"
                     Foreground="{StaticResource Muted}" Margin="6,0,14,0"/>
          <TextBlock Grid.Column="4" Text="{Binding waypoint_label}" FontSize="11"
                     Foreground="{StaticResource Gold}" Visibility="{Binding waypoint_visible}"
                     Margin="0,0,14,0"/>
          <TextBlock Grid.Column="5" Text="{Binding map_hint}" FontSize="11"
                     Foreground="{StaticResource Muted}"/>
        </Grid>

        <StackPanel Grid.Row="3">
          <TextBlock Text="{Binding map_empty_text}" FontSize="12"
                     Foreground="{StaticResource Muted}"
                     Visibility="{Binding map_rows_empty}" Margin="0,6"/>
          <ScrollViewer Height="110">
            <ItemsControl ItemsSource="{Binding map_rows}" ItemTemplate="{StaticResource MapRowTemplate}"/>
          </ScrollViewer>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>

  <!-- ── viagem rápida ─────────────────────────────────────────────────── -->
  <Grid Visibility="{Binding travel_open}" Background="#C80C0A09">
    <Border Width="620" Height="560" HorizontalAlignment="Center" VerticalAlignment="Center"
            Background="#FF0D1210" BorderBrush="#70A8854C" BorderThickness="1"
            CornerRadius="12" Padding="22,16">
      <Grid RowDefinitions="Auto,*,Auto">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PackIcon Kind="Location" Width="20" Height="20" Foreground="{StaticResource Gold}"
                        VerticalAlignment="Center"/>
              <TextBlock Text="{Binding travel_title}" FontSize="26" FontWeight="Bold"
                         FontFamily="Noto Serif Display, serif"
                         Foreground="{StaticResource Gold}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="{Binding travel_sub}" FontSize="13" Foreground="{StaticResource Muted}"/>
          </StackPanel>
          <Button Grid.Column="1" Content="×" Command="{Binding map_command}"
                  CommandParameter="travel-close" Width="34" Height="34" FontSize="18"
                  Padding="0" Background="#66171D20" Foreground="#FFE6D5AD"
                  BorderBrush="#55B7A477" BorderThickness="1"/>
        </Grid>
        <StackPanel Grid.Row="1">
          <TextBlock Text="{Binding travel_empty_text}" FontSize="12"
                     Foreground="{StaticResource Muted}"
                     Visibility="{Binding travel_rows_empty}" Margin="0,10"/>
          <ScrollViewer Height="420">
            <ItemsControl ItemsSource="{Binding travel_rows}" ItemTemplate="{StaticResource MapRowTemplate}"/>
          </ScrollViewer>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Grid>
