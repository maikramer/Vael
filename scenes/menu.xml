<!--
  Cena de menu — o acampamento do Capítulo I.

  É a PRIMEIRA cena carregada pelo jogo (`project.start-scene` no
  config.yaml): terreno pequeno (220 m), clareira plana e um acampamento
  à volta da fogueira. O título é um autoload e cobre-a; o mundo grande
  (`main`) só é carregado quando o jogador escolhe Continuar/Novo Jogo.

  O céu é especializado pelo projeto a partir da cena principal
  (`src/app.rs`); aqui só se declara o relógio e a luz. A cena não tem
  jogabilidade: não há spawners, criaturas, colheita nem portais.
-->
<world static="true" clear-color="#12100d" title="Acampamento">
  <SceneEntry name="entrada" translation="0 8.35 18" euler="0 180 0" />

  <!-- Relógio, clima e mixer são do JOGO: só a primeira cena os declara
       (`spawn::startup` first_load). Têm de casar com world/environment.xml,
       senão o menu muda o amanhecer e o ciclo de chuva da partida toda. -->
  <DayCycle minute-of-day="480" minutes-per-real-second="1.2" dawn-minute="330" dusk-minute="1170" sun-azimuth-base="205" max-sun-elevation="62" drive-ambient="1" ambient-day-intensity="0.26" ambient-night-intensity="0.32" day-speed-scale="0.5" night-speed-scale="2.0" night-cap-minute="1200" />
  <Weather wind="0.7 0.25" wind-strength="1.5" clouds="0.25" rain="0" cycle="1" />
  <AudioMixer master="1" music="0.7" sfx="0.8" voice="0.9" ambience="0.7" />
  <MusicLayer layer="menu" sound="bgm-menu" base-volume="0.24" />

  <Entity>
    <DirectionalLight euler="-45 35.2644 15" />
    <AmbientLight color="0xc8d8e8" brightness="110" />
  </Entity>

  <!-- Sem criaturas nem deslocação: a navmesh custava ~5 s de boot e a
