<?xml version="1.0" encoding="UTF-8"?>
<world clear-color="#8fc2ef" static="true">
  <!-- QA do mapa regional [M] + fumo korok (peça p2-exploration r2).
       Esqueleto do qa-fantasia (MESMO world.data/terrain.ahgt) + os módulos
       da revelação: world/landmarks/*.xml (Nota + marcos de bioma),
       towers.xml (5 atalaias) e koroks.xml (colunas de fumo). O save é do
       PROJETO (`project.main-scene`): este QA PARTILHA o save do world.xml —
       não graves a partir daqui. -->
  <Include src="/world/environment.xml" />
  <SpawnGate target-entity="player" y-fallback="150" />
  <Group name="world-base" translation="0 38.7305 0">
    <Terrain render-distance="950" world-size="4000" max-height="200" levels="5" resolution="128" collision-resolution="64" lod-hysteresis="1.3" lod-distance-ratio="1.7" height-smoothing="1" heightmap="world.data/terrain.ahgt" base-color="#c9c5ba" layers="grass vale_grass dirt dirt_trail forest_floor gravel mountain_stone sand desert_sand snow_peak swamp_mud dirt_road" shore-width="6" snow-height="0.92" cliff-angle="50" sharpen="true" sharpen-angle="35" sharpen-seed="7" cliff-streaks="0.55" cliff-moss="0.4" />
    <NavMesh />
  </Group>
  <Include src="/world/landmarks/forest.xml" />
  <Include src="/world/landmarks/desert.xml" />
  <Include src="/world/landmarks/swamp.xml" />
  <Include src="/world/landmarks/peaks.xml" />
  <Include src="/world/landmarks/wilds.xml" />
  <Include src="/world/landmarks/village.xml" />
  <Include src="/world/towers.xml" />
  <Include src="/world/koroks.xml" />
  <!-- O mapa [M], o [F] de assinar e o [G] de viajar são do plugin Rust
       (`src/ui/map.rs` + `src/ui/waypoint.rs`). O include traz os restantes
       controllers de `world/gameplay.xml`. -->
  <Include src="/world/gameplay.xml" />
  <!-- O HUD (`ui/hud.xaml`) e a barra de fala (`world/say.xml`) vêm do autoload. -->
</world>
