# Shaders especializados, reescritos por `viber run`.
shaders/

# Backups locais e lixo de agente.
*.bak
*.pid
.omo/
.claude/
logs/
__pycache__/

# Modelos NLU/d1 e o laboratório de treino vivem no checkout irmão CelerAI
# (models/ + tools/); aqui ficam só os symlinks de consumo (fetch_models.sh).
assets/public/nlu
assets/public/d1

# Pool: só o modelo BASE vai para o LFS. LOD1/LOD2 são derivados e
# reconstruídos com `tools/make_lods.py` (mesmo binário + mesmos parâmetros
# em qualquer máquina). `_intermediate` é cache local de geração.
# (espelho de assets/.gitignore, para quem clona só a raiz)
assets/public/assets/meshes/**
!assets/public/assets/meshes/**/
!assets/public/assets/meshes/**/*_lod0.glb
!assets/public/assets/meshes/**/*_collision.glb
!assets/public/assets/meshes/vegetation/*.glb
assets/public/assets/meshes/**/_intermediate/
assets/public/assets/images/
assets/public/assets/sky/
# `assets/public/assets/audio/sfx/` NÃO é ignorado: é o pool canónico que a
# engine carrega (`assets.roots`), e um clone limpo tem de trazer os efeitos.
assets/__pycache__/
**/__pycache__/
**/.gameassets_work/
# Estado local das sessões do agente.
.zcode/
# Lock do `gameassets batch|resume` (PID/host/comando; efémero).
.gameassets_batch.lock

# Build do crate Rust (o Cargo.lock FICA versionado).
target/
