# Binários do jogo. Receitas (yaml/json/xml/lua) ficam em git normal.
# GLBs finais entram quando se publicam; _intermediate continua no gitignore.
*.ktx2 filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.webp filter=lfs diff=lfs merge=lfs -text
*.ahgt filter=lfs diff=lfs merge=lfs -text
*.paint filter=lfs diff=lfs merge=lfs -text
*.vinst filter=lfs diff=lfs merge=lfs -text
*.wasm filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text

# NLU (GLiNER2) — artefacto de runtime. Modelo e tensores vão em LFS; o
# tokenizer e a config são pequenos e ficam em git normal.
assets/public/nlu/*.onnx filter=lfs diff=lfs merge=lfs -text
assets/public/nlu/*.data filter=lfs diff=lfs merge=lfs -text
assets/public/nlu/*.bin filter=lfs diff=lfs merge=lfs -text

# d1-omni (decisão) — mesmo tratamento: motor ONNX e embedding int8 em LFS.
assets/public/d1/*.onnx filter=lfs diff=lfs merge=lfs -text
assets/public/d1/*.data filter=lfs diff=lfs merge=lfs -text
assets/public/d1/*.bin filter=lfs diff=lfs merge=lfs -text
